{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:conciliaciones:vista:1.1.0",
  "title": "Plantilla de vista paramétrica",
  "description": "Contrato de la plantilla que devuelve GET /Conciliaciones/subprocesos-ui/plantilla?reglaId=&tipoBlock= dentro de resultado.plantilla (como objeto o como texto JSON). Describe qué bloques pinta la vista (tablas con TanStack Table v9, acordeones y pestañas) y de dónde sale cada dato.",
  "type": "object",
  "required": [
    "layout",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Versión del contrato (1.x). Si falta, el front asume la 1."
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "identifier": {
      "description": "Identificador: letras, números, guiones y guion bajo (admite UUID).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "fieldPath": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "apiPath": {
      "description": "Ruta relativa al API base, con llaves {param} que se resuelven con los parámetros de la ruta del front.",
      "type": "string",
      "pattern": "^/(?!/)[^:?#\\\\]*$"
    },
    "tone": {
      "enum": [
        "neutral",
        "info",
        "success",
        "warning",
        "danger"
      ]
    },
    "emphasis": {
      "enum": [
        "default",
        "lead",
        "highlight"
      ]
    },
    "fractionDigits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "layout": {
      "type": "object",
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stack"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "blockId"
            ],
            "additionalProperties": false,
            "properties": {
              "blockId": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "block": {
      "description": "Los bloques nombrados en layout.items se pintan en ese orden. Un bloque que no está en el layout solo se pinta si otro lo referencia (p. ej. tabs[].blockId).",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "table",
            "accordion",
            "tabs"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/tableBlock"
        },
        {
          "$ref": "#/$defs/accordionBlock"
        },
        {
          "$ref": "#/$defs/tabsBlock"
        }
      ]
    },
    "emptyState": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "recordSource": {
      "description": "Fuente de un objeto (no una página). Para el bloque accordion, con la forma de GET /Conciliaciones/fuentes-detalle (ver fuentes.schema.json).",
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/apiPath"
        },
        "query": {
          "$ref": "#/$defs/queryParams"
        }
      }
    },
    "accordionBlock": {
      "description": "Acordeones (v1.1). Los datos salen siempre de GET /Conciliaciones/fuentes-detalle (fuente fija del front; dataSource se ignora). Con accordion.items hay un acordeón por elemento (id = nombre de la fuente); sin items, uno por fuente con todos sus datos.",
      "type": "object",
      "required": [
        "id",
        "type",
        "accordion"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "accordion"
        },
        "title": {
          "description": "Título de la sección. Admite {campo} de la respuesta de la fuente (fuera de data).",
          "type": "string"
        },
        "dataSource": {
          "description": "Se ignora: la fuente de los acordeones es fija del front.",
          "$ref": "#/$defs/recordSource"
        },
        "accordion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "description": "multiple: varios abiertos a la vez. single: al abrir uno se cierra el otro.",
              "enum": [
                "single",
                "multiple"
              ],
              "default": "multiple"
            },
            "layoutColumns": {
              "description": "Cuántas columnas de la pantalla ocupan los acordeones. Con 2, en pantallas anchas la primera mitad de las fuentes va a la izquierda y el resto a la derecha.",
              "enum": [
                1,
                2
              ],
              "default": 1
            },
            "titleField": {
              "description": "Solo sin items: nombre del dato que va como título de la tarjeta (\"Número de guía\" → \"Número de guía: 70002333336\").",
              "type": "string",
              "minLength": 1
            },
            "cellsByType": {
              "description": "Celda para cada valor de datos[].tipo cuando la columna no trae cell. Un tipo que no está aquí usa la celda por defecto del front (texto si no lo reconoce).",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/valueCell"
              }
            },
            "emptyState": {
              "$ref": "#/$defs/emptyState"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/accordionItem"
              }
            }
          }
        }
      }
    },
    "valueCell": {
      "description": "Celdas que solo muestran un valor (las mismas del catálogo de la tabla, sin LinkCell ni RowCheckbox).",
      "type": "object",
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "enum": [
            "TextCell",
            "NumberCell",
            "CurrencyCell",
            "PercentCell",
            "DateCell",
            "BooleanCell",
            "BadgeCell"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/textCell"
        },
        {
          "$ref": "#/$defs/numberCell"
        },
        {
          "$ref": "#/$defs/currencyCell"
        },
        {
          "$ref": "#/$defs/percentCell"
        },
        {
          "$ref": "#/$defs/dateCell"
        },
        {
          "$ref": "#/$defs/booleanCell"
        },
        {
          "$ref": "#/$defs/badgeCell"
        }
      ]
    },
    "tabsBlock": {
      "description": "Pestañas (v1.1). Cada pestaña muestra otro bloque de la plantilla.",
      "type": "object",
      "required": [
        "id",
        "type",
        "tabs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "tabs"
        },
        "tabs": {
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "defaultTab": {
              "description": "id de la pestaña abierta al entrar. Por defecto, la primera habilitada.",
              "$ref": "#/$defs/identifier"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "blockId"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/identifier"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blockId": {
                    "description": "id del bloque que se pinta dentro de la pestaña. Ese bloque no va en layout.items.",
                    "$ref": "#/$defs/identifier"
                  },
                  "disabled": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "required": [
        "id",
        "type",
        "table"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "table"
        },
        "title": {
          "type": "string"
        },
        "dataSource": {
          "$ref": "#/$defs/dataSource"
        },
        "table": {
          "$ref": "#/$defs/table"
        }
      }
    },
    "dataSource": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/apiPath"
        },
        "query": {
          "$ref": "#/$defs/queryParams"
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "description": "server: el front envía pageNumber y pageSize. none: no los envía y el back devuelve todas las filas.",
              "enum": [
                "server",
                "none"
              ],
              "default": "server"
            },
            "defaultPageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "pageSizeOptions": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "uniqueItems": true
            }
          }
        },
        "sorting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "server",
                "client"
              ],
              "default": "server"
            },
            "multi": {
              "type": "boolean",
              "default": false
            },
            "default": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "desc"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/identifier"
                  },
                  "desc": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "filtering": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "server",
                "client"
              ],
              "default": "server"
            }
          }
        }
      },
      "description": "Fuente de una tabla. En la pantalla Regla la fuente es fija del front (/Conciliaciones/subprocesos-registros/reglas): la plantilla solo aporta pagination y sorting, y path se ignora."
    },
    "table": {
      "type": "object",
      "required": [
        "rowId",
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "rowId": {
          "$ref": "#/$defs/fieldPath"
        },
        "density": {
          "enum": [
            "default",
            "compact"
          ],
          "default": "default"
        },
        "emptyState": {
          "$ref": "#/$defs/emptyState"
        },
        "selection": {
          "description": "Selección de filas. Se identifica cada fila por rowId, así que la selección sobrevive al orden y a la paginación.",
          "type": "object",
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "multi"
            },
            "persistAcrossPages": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      },
      "if": {
        "properties": {
          "columns": {
            "contains": {
              "type": "object",
              "required": [
                "cell"
              ],
              "properties": {
                "cell": {
                  "properties": {
                    "component": {
                      "const": "RowCheckbox"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "selection"
        ]
      }
    },
    "column": {
      "oneOf": [
        {
          "$ref": "#/$defs/groupColumn"
        },
        {
          "$ref": "#/$defs/leafColumn"
        }
      ]
    },
    "groupColumn": {
      "type": "object",
      "required": [
        "id",
        "header",
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "header": {
          "$ref": "#/$defs/header"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "leafColumn": {
      "type": "object",
      "required": [
        "id",
        "header"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "accessorKey": {
          "$ref": "#/$defs/fieldPath"
        },
        "header": {
          "$ref": "#/$defs/header"
        },
        "cell": {
          "$ref": "#/$defs/cell"
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "align": {
              "enum": [
                "start",
                "center",
                "end"
              ]
            },
            "width": {
              "oneOf": [
                {
                  "enum": [
                    "fill",
                    "hug"
                  ]
                },
                {
                  "type": "integer",
                  "minimum": 40
                }
              ]
            }
          }
        },
        "enableSorting": {
          "type": "boolean",
          "default": false
        },
        "sortType": {
          "enum": [
            "alphanumeric",
            "text",
            "basic",
            "datetime"
          ]
        },
        "enableColumnFilter": {
          "type": "boolean",
          "default": false
        },
        "filter": {
          "$ref": "#/$defs/filter"
        },
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "enableHiding": {
          "type": "boolean",
          "default": true
        },
        "pin": {
          "enum": [
            "start",
            "end"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cell": {
                "properties": {
                  "component": {
                    "enum": [
                      "LinkCell",
                      "RowCheckbox"
                    ]
                  }
                }
              }
            },
            "required": [
              "cell"
            ]
          },
          "then": {
            "properties": {
              "enableSorting": {
                "const": false
              },
              "enableColumnFilter": {
                "const": false
              }
            }
          },
          "else": {
            "required": [
              "accessorKey"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "enableColumnFilter": {
                "const": true
              }
            },
            "required": [
              "enableColumnFilter"
            ]
          },
          "then": {
            "required": [
              "filter"
            ]
          },
          "else": {
            "not": {
              "required": [
                "filter"
              ]
            }
          }
        }
      ]
    },
    "header": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "component",
            "inputs"
          ],
          "additionalProperties": false,
          "properties": {
            "component": {
              "const": "SortIndicator"
            },
            "inputs": {
              "type": "object",
              "required": [
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "component",
            "inputs"
          ],
          "additionalProperties": false,
          "properties": {
            "component": {
              "const": "SelectAllCheckbox"
            },
            "inputs": {
              "type": "object",
              "required": [
                "ariaLabel"
              ],
              "additionalProperties": false,
              "properties": {
                "ariaLabel": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "cell": {
      "type": "object",
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "enum": [
            "TextCell",
            "NumberCell",
            "CurrencyCell",
            "PercentCell",
            "DateCell",
            "BooleanCell",
            "BadgeCell",
            "LinkCell",
            "RowCheckbox"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/textCell"
        },
        {
          "$ref": "#/$defs/numberCell"
        },
        {
          "$ref": "#/$defs/currencyCell"
        },
        {
          "$ref": "#/$defs/percentCell"
        },
        {
          "$ref": "#/$defs/dateCell"
        },
        {
          "$ref": "#/$defs/booleanCell"
        },
        {
          "$ref": "#/$defs/badgeCell"
        },
        {
          "$ref": "#/$defs/linkCell"
        },
        {
          "$ref": "#/$defs/rowCheckbox"
        }
      ]
    },
    "textCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "TextCell"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emphasis": {
              "$ref": "#/$defs/emphasis"
            },
            "secondaryAccessorKey": {
              "$ref": "#/$defs/fieldPath"
            },
            "truncate": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "numberCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "NumberCell"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emphasis": {
              "$ref": "#/$defs/emphasis"
            },
            "minimumFractionDigits": {
              "$ref": "#/$defs/fractionDigits"
            },
            "maximumFractionDigits": {
              "$ref": "#/$defs/fractionDigits"
            }
          }
        }
      }
    },
    "currencyCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "CurrencyCell"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emphasis": {
              "$ref": "#/$defs/emphasis"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "currencyField": {
              "$ref": "#/$defs/fieldPath"
            },
            "minimumFractionDigits": {
              "$ref": "#/$defs/fractionDigits"
            },
            "maximumFractionDigits": {
              "$ref": "#/$defs/fractionDigits"
            },
            "signDisplay": {
              "enum": [
                "auto",
                "always",
                "exceptZero",
                "never"
              ]
            }
          }
        }
      }
    },
    "percentCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "PercentCell"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emphasis": {
              "$ref": "#/$defs/emphasis"
            },
            "minimumFractionDigits": {
              "$ref": "#/$defs/fractionDigits"
            },
            "maximumFractionDigits": {
              "$ref": "#/$defs/fractionDigits"
            }
          }
        }
      }
    },
    "dateCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "DateCell"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dateStyle": {
              "enum": [
                "short",
                "medium",
                "long"
              ]
            },
            "timeStyle": {
              "enum": [
                "short",
                "medium"
              ]
            },
            "timeZone": {
              "description": "Zona IANA en la que se muestra la fecha (p. ej. America/Bogota). Si falta, se usa la del navegador.",
              "type": "string",
              "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$"
            }
          }
        }
      }
    },
    "booleanCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "BooleanCell"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trueLabel": {
              "type": "string"
            },
            "falseLabel": {
              "type": "string"
            }
          }
        }
      }
    },
    "badgeCell": {
      "type": "object",
      "required": [
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "BadgeCell"
        },
        "inputs": {
          "type": "object",
          "required": [
            "variants"
          ],
          "additionalProperties": false,
          "properties": {
            "variants": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "required": [
                  "label",
                  "tone"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "tone": {
                    "$ref": "#/$defs/tone"
                  }
                }
              }
            },
            "fallback": {
              "type": "object",
              "required": [
                "label",
                "tone"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                },
                "tone": {
                  "$ref": "#/$defs/tone"
                }
              }
            }
          }
        }
      }
    },
    "linkCell": {
      "type": "object",
      "required": [
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "LinkCell"
        },
        "inputs": {
          "type": "object",
          "required": [
            "label",
            "ariaLabel",
            "route"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "ariaLabel": {
              "type": "string"
            },
            "route": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "visibleWhen": {
              "type": "object",
              "required": [
                "field",
                "equals"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "$ref": "#/$defs/fieldPath"
                },
                "equals": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "rowCheckbox": {
      "type": "object",
      "required": [
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "RowCheckbox"
        },
        "inputs": {
          "type": "object",
          "required": [
            "ariaLabel"
          ],
          "additionalProperties": false,
          "properties": {
            "ariaLabel": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "filter": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "component"
          ],
          "additionalProperties": false,
          "properties": {
            "component": {
              "const": "TextFilter"
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "placeholder": {
                  "type": "string"
                },
                "minLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "component",
            "inputs"
          ],
          "additionalProperties": false,
          "properties": {
            "component": {
              "const": "SelectFilter"
            },
            "inputs": {
              "type": "object",
              "required": [
                "options"
              ],
              "additionalProperties": false,
              "properties": {
                "multiple": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "value",
                      "label"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "component"
          ],
          "additionalProperties": false,
          "properties": {
            "component": {
              "enum": [
                "DateRangeFilter",
                "NumberRangeFilter"
              ]
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fromLabel": {
                  "type": "string"
                },
                "toLabel": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "queryParams": {
      "description": "Parámetros de consulta de la fuente. Cada valor admite llaves {param} con los parámetros de la ruta del front ({proyectoId}, {procesoId}, {subProcesoId}, {reglaId}, {conciliacionId}).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "accordionItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "nombre de la fuente en fuentes-detalle (p. ej. fuentePrepagoMovimiento).",
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "description": "Texto del acordeón. El front lo muestra tal como llega: debe ser un nombre para el usuario, no el id técnico.",
          "type": "string"
        },
        "defaultOpen": {
          "type": "boolean",
          "default": false
        },
        "content": {
          "$ref": "#/$defs/fieldList"
        }
      }
    },
    "fieldList": {
      "description": "Contenido de un acordeón: una columna por dato (encabezado / valor). Si ninguna trae dato, o la fuente no llega, se muestra emptyState.",
      "type": "object",
      "required": [
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Admite {campo} con los datos de la fuente: \"Número de guía: {numeroGuia}\". Si falta alguno, no se muestra.",
          "type": "string"
        },
        "emptyState": {
          "$ref": "#/$defs/emptyState"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fieldColumn"
          }
        }
      }
    },
    "fieldColumn": {
      "description": "Mismo vocabulario que la columna hoja de una tabla (id, accessorKey, header, cell). accessorKey es el nombre del dato en la fuente (sin distinguir mayúsculas). Sin cell, la celda sale del tipo del dato.",
      "type": "object",
      "required": [
        "id",
        "header",
        "accessorKey"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "accessorKey": {
          "type": "string",
          "minLength": 1
        },
        "header": {
          "type": "string",
          "minLength": 1
        },
        "cell": {
          "$ref": "#/$defs/valueCell"
        }
      }
    }
  }
}
